---
import type { CollectionEntry } from 'astro:content';
import { TagBadges } from '../components/TagBadges';
import { Separator } from '../components/ui/separator';
import { AUTHORS, SITE_TITLE, TAGS, withBase } from '../consts';
import { formatDate } from '../lib/date';
import Base from './Base.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, authors, tags } = Astro.props;
---

<Base title={`${title} | ${SITE_TITLE}`} description={description}>
	<article class="mx-auto max-w-2xl">
		<header class="flex flex-col gap-3">
			<h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
			<p class="text-sm text-muted-foreground">
				<time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
				{
					authors.map((key) => (
						<span>
							{' · '}
							<a class="underline-offset-4 hover:underline" href={AUTHORS[key].url}>
								{AUTHORS[key].name}
							</a>{' '}
							({AUTHORS[key].title})
						</span>
					))
				}
				{updatedDate && <span> · 최종 수정: {formatDate(updatedDate)}</span>}
			</p>
			<TagBadges
				tags={tags.map((tag) => ({
					label: TAGS[tag].label,
					href: withBase(`/tags/${tag}/`),
				}))}
			/>
		</header>
		<Separator className="my-8" />
		<div class="prose max-w-none">
			<slot />
		</div>
	</article>
</Base>
