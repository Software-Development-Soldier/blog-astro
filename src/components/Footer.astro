---
import { withBase } from '../consts';

const today = new Date();
---

<footer class="border-t">
	<div
		class="mx-auto flex w-full max-w-4xl flex-wrap items-center justify-between gap-2 px-4 py-6 text-sm text-muted-foreground"
	>
		<p>Copyright &copy; {today.getFullYear()} 정보체계관리단. Built with Astro.</p>
		<div class="flex gap-4">
			<a class="hover:text-foreground" href={withBase('/tags/')}>태그</a>
			<a class="hover:text-foreground" href={withBase('/rss.xml')}>RSS</a>
		</div>
	</div>
</footer>
