---
import { REPO_URL, SITE_TITLE, withBase } from '../consts';
import { NavLink } from './NavLink';
import { ThemeToggle } from './ThemeToggle';

const links = [
	{ href: '/', label: '홈' },
	{ href: '/tags/', label: '태그' },
];

const current = Astro.url.pathname.replace(/\/?$/, '/');
const isActive = (href: string) => {
	const target = withBase(href);
	return href === '/' ? current === target : current.startsWith(target);
};
---

<header class="sticky top-0 z-10 border-b bg-background/80 backdrop-blur">
	<nav class="mx-auto flex h-14 w-full max-w-4xl items-center gap-1 px-4">
		<a href={withBase('/')} class="mr-3 font-semibold tracking-tight">{SITE_TITLE}</a>
		{
			links.map((link) => (
				<NavLink
					href={withBase(link.href)}
					label={link.label}
					variant={isActive(link.href) ? 'secondary' : 'ghost'}
					current={isActive(link.href)}
				/>
			))
		}
		<div class="ml-auto flex items-center gap-1">
			<NavLink href={REPO_URL} label="GitHub" variant="outline" external className="max-sm:hidden" />
			<ThemeToggle />
		</div>
	</nav>
</header>

<script is:inline>
	document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
		const dark = document.documentElement.classList.toggle('dark');
		try {
			localStorage.setItem('theme', dark ? 'dark' : 'light');
		} catch {}
	});
</script>
