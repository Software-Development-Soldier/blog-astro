---
import type { CollectionEntry } from 'astro:content';
import { TAGS, withBase } from '../consts';
import { formatDate } from '../lib/date';
import { PostCard } from './PostCard';

interface Props {
	posts: CollectionEntry<'blog'>[];
}

const posts = [...Astro.props.posts].sort(
	(a, b) =>
		b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || a.id.localeCompare(b.id),
);
---

<ul class="grid gap-6 sm:grid-cols-2">
	{
		posts.map((post) => (
			<li>
				<PostCard
					title={post.data.title}
					href={withBase(`/${post.id}/`)}
					date={formatDate(post.data.pubDate)}
					description={post.data.description}
					tags={post.data.tags.map((tag) => ({
						label: TAGS[tag].label,
						href: withBase(`/tags/${tag}/`),
					}))}
				/>
			</li>
		))
	}
</ul>
