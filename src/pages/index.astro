---
import { getCollection } from 'astro:content';
import PostList from '../components/PostList.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import Base from '../layouts/Base.astro';

const posts = await getCollection('blog');
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="mb-10 flex flex-col gap-2">
		<h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{SITE_TITLE}</h1>
		<p class="text-muted-foreground">{SITE_DESCRIPTION}</p>
	</section>
	<PostList posts={posts} />
</Base>
