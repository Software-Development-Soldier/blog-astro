---
import { getCollection } from 'astro:content';
import { Badge } from '../../components/ui/badge';
import { Card, CardDescription, CardHeader, CardTitle } from '../../components/ui/card';
import { SITE_TITLE, TAGS, type TagKey, withBase } from '../../consts';
import Base from '../../layouts/Base.astro';

const posts = await getCollection('blog');
const tags = (Object.keys(TAGS) as TagKey[])
	.map((key) => ({
		key,
		...TAGS[key],
		count: posts.filter((post) => post.data.tags.includes(key)).length,
	}))
	.filter((tag) => tag.count > 0);
---

<Base title={`태그 | ${SITE_TITLE}`} description="태그별 글 모음">
	<h1 class="mb-8 text-3xl font-bold tracking-tight">태그</h1>
	<ul class="grid gap-4 sm:grid-cols-3">
		{
			tags.map((tag) => (
				<li>
					<a href={withBase(`/tags/${tag.key}/`)} class="block h-full">
						<Card className="h-full">
							<CardHeader>
								<CardTitle className="flex items-center gap-2">
									{tag.label}
									<Badge variant="secondary">{tag.count}</Badge>
								</CardTitle>
								<CardDescription>{tag.description}</CardDescription>
							</CardHeader>
						</Card>
					</a>
				</li>
			))
		}
	</ul>
</Base>
