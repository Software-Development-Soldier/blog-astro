---
import { getCollection } from 'astro:content';
import PostList from '../../components/PostList.astro';
import { SITE_TITLE, TAGS, type TagKey } from '../../consts';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return (Object.keys(TAGS) as TagKey[])
		.map((tag) => ({
			params: { tag },
			props: { posts: posts.filter((post) => post.data.tags.includes(tag)) },
		}))
		.filter((path) => path.props.posts.length > 0);
}

const tag = Astro.params.tag as TagKey;
const { posts } = Astro.props;
---

<Base title={`${TAGS[tag].label} | ${SITE_TITLE}`} description={TAGS[tag].description}>
	<section class="mb-10 flex flex-col gap-2">
		<h1 class="text-3xl font-bold tracking-tight">태그: {TAGS[tag].label}</h1>
		<p class="text-muted-foreground">{TAGS[tag].description}</p>
	</section>
	<PostList posts={posts} />
</Base>
